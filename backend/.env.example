# PlanMe Backend — Environment Variables
# Copy this file to .env and fill in real values before running the server.
# NEVER commit .env to version control.

# Hugging Face Inference API token.
# Required for AI meal plan generation (Qwen/Qwen2.5-7B-Instruct).
# Without this, every plan falls back to rule-based scheduling.
# Get your token at: https://huggingface.co/settings/tokens
HF_TOKEN=

# JWT signing secret — change to a long random string in production.
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=planme-dev-secret-change-in-prod

# SQLite database path (relative to backend directory)
# For production, swap to a postgres:// URL
DATABASE_URL=sqlite:///planme.db
